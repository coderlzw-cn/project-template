{
  "editor.codeActionsOnSave": {
    "source.fixAll.oxc": "explicit"
  },
  // 统一用 oxc 扩展（内部调用项目里的 oxfmt）作为默认格式化器，保存时自动格式化
  "editor.defaultFormatter": "oxc.oxc-vscode",
  "editor.formatOnSave": true,

  // i18n Ally Next：src/i18n/locales/{locale}/{namespace}.ts
  "i18n-ally-next.localesPaths": ["src/i18n/locales"],
  "i18n-ally-next.sourceLanguage": "zh-CN",
  "i18n-ally-next.displayLanguage": "zh-CN",
  "i18n-ally-next.enabledFrameworks": ["react-i18next"],
  "i18n-ally-next.enabledParsers": ["ts"],
  "i18n-ally-next.dirStructure": "dir",
  "i18n-ally-next.namespace": true,
  "i18n-ally-next.defaultNamespace": "common",
  "i18n-ally-next.pathMatcher": "{locale}/{namespace}.{ext}",
  "i18n-ally-next.keystyle": "nested",
  "i18n-ally-next.ignoreFiles": ["**/index.ts"],
  "i18n-ally-next.annotationInPlace": false,
  // 项目 package.json 是 "type": "module"，插件自带的 ts-node 无法 require 这些 .ts 语言包
  "i18n-ally-next.parsers.typescript.tsNodePath": "/Users/liangzhiwei/开发/project-template/.vscode/i18n-ally-next-loader.cjs",
  "[typescript]": {
    "editor.defaultFormatter": "vscode.typescript-language-features"
  }
}
