{
  "editor.codeActionsOnSave": {
    "source.fixAll.oxc": "explicit"
  },
  // 统一用 oxc 扩展（内部调用项目里的 oxfmt）作为默认格式化器，保存时自动格式化
  "editor.defaultFormatter": "oxc.oxc-vscode",
  "editor.formatOnSave": true,

  // 国际化
  "i18n-ally.localesPaths": ["src/i18n/locales"],
  "i18n-ally.sourceLanguage": "zh-CN",
  "i18n-ally.displayLanguage": "zh-CN",
  "i18n-ally.enabledFrameworks": ["react-i18next"],
  // 限制启用的资源格式解析器；语言包现在使用 TypeScript
  "i18n-ally.enabledParsers": ["ts"],
  // 兼容 TypeScript 6，避免 i18n-ally 的 ts-node 推断出错误的 rootDir 和过时 target
  "i18n-ally.parsers.typescript.compilerOptions": {
    "rootDir": ".",
    "target": "ES2022"
  },
  // 使用 TS 文件名作为 i18next namespace
  "i18n-ally.namespace": true,
  "i18n-ally.pathMatcher": "{locale}/{namespace}.ts",
  "i18n-ally.sortKeys": true,
  "i18n-ally.annotationInPlace": false
}
