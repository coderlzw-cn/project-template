NODE_ENV=development
DATABASE_LOG_NETWORK=false
DATABASE_LOG_QUERY=false
DATABASE_LOG_ERROR=true
DATABASE_LOG_WARNING=true
HOST=0.0.0.0
PORT=3778
PREFIX_API=api

# --------------------- 证书
LICENSE_PATH="license.lic"
LICENSE_MAX_SIZE=65536
LICENSE_PRIVATE_KEY_PATH="license-private.pem"
LICENSE_PUBLIC_KEY_PATH="license-public.pem"
LICENSE_CUSTOMER="coderlzw"
LICENSE_PRODUCT="Nestjs"
LICENSE_ISSUER="coderlzw"
LICENSE_AUDIENCE="web-app"

# --------------------- 数据库
DATABASE_URL="mysql://root:root@192.168.5.161:3306/nest_db?allowPublicKeyRetrieval=true&useSSL=false"

# --------------------- 登录认证
# 开启认证功能，默认开启
AUTH_ENABLED=true
# JWT 有效期（秒）：access token 15 分钟，refresh token 7 天
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=604800
JWT_PRIVATE_KEY_PATH="private.pem"
JWT_PUBLIC_KEY_PATH="public.pem"
JWT_ISSUER="nestjs"
JWT_AUDIENCE="web-app"
