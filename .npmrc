registry=https://registry.npmmirror.com/

# 关闭严格 SSL 校验，避免内网/代理环境下 SSL 验证失败
# strict-ssl=false

# 安装时不自动打开浏览器（避免某些包安装后弹浏览器）
# open=false

# 允许脚本执行，避免安装某些包时报错（如 node-sass、electron）
# ignore-scripts=false

# 安装失败时自动重试次数
# fetch-retries=5

# 请求超时时间（毫秒），网络差时更稳定
# timeout=60000

# 优先使用本地缓存，不频繁请求网络
# prefer-offline=true

# 缓存最小有效时间（分钟），这里 1 天内不重新请求
# cache-min=1440

# 最大缓存大小（MB）
# cache-max=10240

# ==============================================
# 权限与全局路径（解决 EACCES 权限错误）
# ==============================================

# 全局安装包时不检查权限，避免 root/权限问题
# unsafe-perm=true

# 全局包安装目录，避免系统目录权限不足
# Windows 可改为 prefix=C:\Users\你的用户名\.npm-global
# prefix=~/.npm-global

# ==============================================
# lock 文件（根据团队规范二选一）
# ==============================================

# 不生成 package-lock.json（适合 monorepo/团队统一版本）
# package-lock=false

# 生成 package-lock.json（保证安装版本一致，默认开启）
package-lock=true