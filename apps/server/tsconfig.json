{
  "extends": "@workspace/tsconfig/tsconfig.base.json",
  "compilerOptions": {
    "esModuleInterop": true,
    "isolatedModules": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "allowSyntheticDefaultImports": true,
    "moduleResolution": "Bundler",
    "target": "es2015",
    "outDir": "dist",
    "baseUrl": "../..",
    "paths": {
      "@app/common": [
        "apps/server/libs/common/src"
      ],
      "@app/common/*": [
        "apps/server/libs/common/src/*"
      ],
      "@app/library": [
        "apps/server/libs/library/src"
      ],
      "@app/library/*": [
        "apps/server/libs/library/src/*"
      ],
      "@workspace/common": [
        "packages/common/src"
      ],
      "@workspace/common/*": [
        "packages/common/src/*"
      ],
      "@workspace/eslint": [
        "packages/eslint"
      ],
      "@workspace/eslint/*": [
        "packages/eslint/*"
      ]
    }
  }
}
