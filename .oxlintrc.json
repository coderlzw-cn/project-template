{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["react", "typescript", "oxc", "import", "unicorn"],
  // 按分类批量启用规则：correctness（确定的错误）报错，suspicious（可疑写法）、perf（性能隐患）告警
  "categories": {
    "correctness": "error",
    "suspicious": "warn",
    "perf": "warn"
  },
  "rules": {
    "react/rules-of-hooks": "error",
    "react/only-export-components": ["warn", { "allowConstantExport": true }],
    // React 17+ 使用自动 JSX 运行时（tsconfig 的 jsx: react-jsx），无需手动引入 React
    "react/react-in-jsx-scope": "off",
    // 样式、polyfill 等副作用导入（如 import "./global.css"）是正常写法
    "import/no-unassigned-import": "off"
  },
  "ignorePatterns": ["dist", "stats.html"]
}
